# Everything that ships to Linux keeps LF endings. Without this a checkout on
# Windows (core.autocrlf=true) rewrites shell scripts to CRLF and they fail at
# runtime with "bad interpreter: /bin/sh^M".
* text=auto eol=lf

*.go        text eol=lf
*.sql       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.md        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
Dockerfile  text eol=lf
